<UserControl x:Class="GameAssetExplorer.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameAssetExplorer.App.ViewModels"
             xmlns:conv="clr-namespace:GameAssetExplorer.App.Views.Converters"
             Background="{StaticResource Bg}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Large-title header -->
            <RowDefinition Height="Auto"/>
            <!-- Library content -->
            <RowDefinition Height="*"/>
            <!-- Status strip -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ── Header (macOS large title) ────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource Bg}">
            <Grid Margin="28,22,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title block -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Library"
                               FontFamily="{StaticResource UiDisplayFont}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Margin="0,2,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSub}">
                        <Run Text="{Binding Games.Count, Mode=OneWay}"/><Run Text=" games in your collection"/>
                    </TextBlock>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Logs"
                            Style="{StaticResource GhostBtn}"
                            Padding="12,7"
                            Margin="0,0,10,0"
                            ToolTip="Open the log folder for sharing diagnostics"
                            Click="OnOpenLogsClick"/>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Command="{Binding AddGameCommand}"
                            ToolTip="Add a game to your library">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,7,0"
                                       Foreground="White"/>
                            <TextBlock Text="Add Game" VerticalAlignment="Center"
                                       Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Game Library Grid ─────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,8">
            <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,120,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Games.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Soft icon disc -->
                    <Border Width="84" Height="84" CornerRadius="20"
                            Background="{StaticResource Surface}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="40"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Your library is empty"
                               FontFamily="{StaticResource UiDisplayFont}"
                               FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"/>
                    <TextBlock Text="Add a game to start browsing and exporting its assets."
                               FontSize="13"
                               Foreground="{StaticResource TextSub}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,18"/>
                    <Button Style="{StaticResource PrimaryBtn}"
                            Command="{Binding AddGameCommand}"
                            HorizontalAlignment="Center"
                            Content="Add Your First Game"/>
                </StackPanel>

                <!-- Game card grid -->
                <ItemsControl x:Name="GameCardsControl"
                              ItemsSource="{Binding Games}"
                              Margin="18,4,18,18">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameLibraryEntry}">
                            <!-- Game Card -->
                            <Border x:Name="Card"
                                    Width="200" Height="286"
                                    Margin="10"
                                    CornerRadius="14"
                                    Background="{StaticResource Surface}"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                                      Color="Black" Opacity="0.35"/>
                                </Border.Effect>

                                <!-- Right-click context menu -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Edit Game Info"
                                                  Click="OnCardEditMenuClick"/>
                                        <Separator/>
                                        <MenuItem Header="Remove from Library"
                                                  Click="OnCardDeleteMenuClick"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <!-- Single click selects, double-click opens -->
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectGameCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.OpenGameCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Border.InputBindings>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="204"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cover area -->
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                        <Grid>
                                            <!-- Gradient placeholder -->
                                            <Border x:Name="GradientPlaceholder">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoverImagePath,
                                                                Converter={StaticResource NotNullConverter}}"
                                                                Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#3A3A3C" Offset="0"/>
                                                        <GradientStop Color="#232325" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding DisplayName[0]}"
                                                           FontFamily="{StaticResource UiDisplayFont}"
                                                           FontSize="80" FontWeight="Bold"
                                                           Foreground="White" Opacity="0.10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Cover art image -->
                                            <Image Source="{Binding CoverImagePath}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoverImagePath,
                                                                Converter={StaticResource NotNullConverter}}"
                                                                Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <!-- ⋯ menu button (appears on hover) -->
                                            <Button x:Name="MenuBtn"
                                                    Content="⋯"
                                                    FontSize="16" FontWeight="Bold"
                                                    Width="30" Height="30"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,8,8,0"
                                                    Panel.ZIndex="2"
                                                    Opacity="0"
                                                    Foreground="White"
                                                    Cursor="Hand"
                                                    ToolTip="Edit / Remove"
                                                    Click="OnCardMenuButtonClick">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="mb"
                                                                Background="#99000000"
                                                                CornerRadius="15">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,-4,0,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="mb" Property="Background" Value="#CC000000"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Info area -->
                                    <StackPanel Grid.Row="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SubtitleDisplay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSub}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card interaction triggers -->
                            <DataTemplate.Triggers>
                                <!-- Hover: lift + reveal menu + deepen shadow -->
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MenuBtn" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Card" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-4"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="Card" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Direction="270"
                                                              Color="Black" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <!-- Selected: accent ring -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- ── Status Strip ──────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Center"/>

                <!-- Loading indicator -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Loading…"
                               FontSize="11"
                               Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
