<UserControl x:Class="GameAssetExplorer.App.Views.AssetBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GameAssetExplorer.App.ViewModels"
             xmlns:models="clr-namespace:GameAssetExplorer.Core.Models;assembly=GameAssetExplorer.Core"
             xmlns:conv="clr-namespace:GameAssetExplorer.App.Views.Converters"
             Background="{StaticResource Bg}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Apple-style small-caps section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="52"/>
            <!-- 3-panel content -->
            <RowDefinition Height="*"/>
            <!-- Merge Queue panel (collapsed until queue has items) -->
            <RowDefinition x:Name="MergeQueueRow" Height="Auto"/>
            <!-- Status strip -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ── Toolbar ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back button (chevron) -->
                <Button Grid.Column="0"
                        Style="{StaticResource GhostBtn}"
                        Command="{Binding GoBackCommand}"
                        Padding="8,6"
                        Margin="0,0,8,0"
                        ToolTip="Back to library">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="‹" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,-2,5,0"
                                   Foreground="{StaticResource Accent}"/>
                        <TextBlock Text="Library" VerticalAlignment="Center"
                                   Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                </Button>

                <!-- Game name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding GameName}"
                           FontFamily="{StaticResource UiDisplayFont}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>

                <!-- Search pill -->
                <Grid Grid.Column="3" Width="280" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             FontSize="13"
                             Padding="30,6,10,6"
                             ToolTip="Search by asset name or path"/>
                    <TextBlock Text="🔍"
                               FontSize="12"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="Search assets"
                               FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="30,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Three-Panel Layout ─────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: File tree (resizable) -->
                <ColumnDefinition Width="248" MinWidth="150"/>
                <ColumnDefinition Width="1"/>
                <!-- Center: Asset list (resizable) -->
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="1"/>
                <!-- Right: Preview + properties -->
                <ColumnDefinition Width="330" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Left Panel: Virtual File Tree (Finder sidebar) ───────── -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="FILES"
                               Style="{StaticResource SectionHeader}"
                               Margin="16,0"/>

                    <TreeView Grid.Row="1"
                              x:Name="FileTree"
                              ItemsSource="{Binding RootNodes}"
                              Background="Transparent"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              MouseDoubleClick="OnFileTreeDoubleClick">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:AssetTreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📄"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Text" Value="📁"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"
                          Cursor="SizeWE"/>

            <!-- ─── Center Panel: Grouped Asset Browser ───────────────────── -->
            <Grid Grid.Column="2" Background="{StaticResource Bg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header bar -->
                <Grid Grid.Row="0" Margin="16,0">
                    <TextBlock Text="ASSETS"
                               Style="{StaticResource SectionHeader}"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="AssetCountLabel"
                               Text="{Binding FilteredAssets.Count, StringFormat='{}{0:N0} items'}"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Loading overlay -->
                <Border Grid.Row="1"
                        Background="{StaticResource Bg}"
                        Panel.ZIndex="1"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading assets…"
                                   Foreground="{StaticResource TextSub}"
                                   HorizontalAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True"
                                     Width="180" Height="4"
                                     Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Grouped asset tree -->
                <TreeView Grid.Row="1"
                          x:Name="AssetGroupTree"
                          ItemsSource="{Binding AssetGroups}"
                          Background="Transparent"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnAssetGroupTreeSelectionChanged"
                          MouseDoubleClick="OnAssetTreeDoubleClick">
                    <TreeView.Resources>

                        <!-- ── Group header (AssetGroupNode) ── -->
                        <HierarchicalDataTemplate DataType="{x:Type vm:AssetGroupNode}"
                                                  ItemsSource="{Binding Assets}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding HeaderIcon}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TypeLabel}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="2"
                                        Background="{StaticResource Panel}"
                                        CornerRadius="9"
                                        Padding="8,1"
                                        Margin="6,0,2,0">
                                    <TextBlock Text="{Binding CountLabel}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSub}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <!-- ── Asset leaf (AssetInfo) ── -->
                        <DataTemplate DataType="{x:Type models:AssetInfo}">
                            <Grid>
                                <!-- Right-click: export options -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Export…"
                                                  Click="OnExportAssetMenuClick"/>
                                        <MenuItem Header="Export as PNG"
                                                  Click="OnExportTextureMenuClick"/>
                                        <MenuItem Header="Export as OBJ"
                                                  Click="OnExportMeshMenuClick"/>
                                        <Separator/>
                                        <MenuItem Header="Export with JSON metadata"
                                                  Click="OnExportWithMetaMenuClick"/>
                                        <Separator/>
                                        <MenuItem Header="Add to Merge Queue"
                                                  Click="OnAddToMergeQueueMenuClick"
                                                  ToolTip="Queue this mesh for combined export with other parts"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CompressedSize, StringFormat='{}{0:N0} B'}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,0"/>
                            </Grid>
                        </DataTemplate>

                    </TreeView.Resources>
                </TreeView>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Border}"
                          Cursor="SizeWE"/>

            <!-- ─── Right Panel: Preview + Info (Inspector) ──────────────── -->
            <Border Grid.Column="4" Background="{StaticResource SidebarBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <!-- Preview area -->
                        <RowDefinition Height="220" MinHeight="90"/>
                        <RowDefinition Height="1"/>
                        <!-- Info / properties -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Preview header -->
                    <TextBlock Grid.Row="0"
                               Text="PREVIEW"
                               Style="{StaticResource SectionHeader}"
                               Margin="16,0"/>

                    <!-- Preview area -->
                    <Border Grid.Row="1" Margin="12,0,12,10"
                            CornerRadius="12"
                            Background="{StaticResource PanelDark}">
                        <Grid>
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewedAsset}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="⌘"
                                           FontSize="30"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.6"/>
                                <TextBlock Text="Select an asset to preview"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- Texture preview -->
                            <Image x:Name="PreviewImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="Collapsed"
                                   Margin="10"/>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="2"
                                  Height="1"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource Border}"
                                  Cursor="SizeNS"/>

                    <!-- Info panel -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="INFO"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="16,0"/>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PropertiesPanel" Margin="16,4"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Merge Queue Panel ─────────────────────────────────────────── -->
        <!-- Appears when IsMergePanelVisible = true; lets the user build a multi-part
             mesh (head + body + armor + hair) and export it as one combined OBJ. -->
        <Border Grid.Row="2"
                x:Name="MergeQueuePanel"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,1"
                Visibility="{Binding IsMergePanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Header row -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Merge Queue"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Border Background="{StaticResource Accent}"
                            CornerRadius="9"
                            Padding="8,1">
                        <TextBlock Text="{Binding MergeQueueCount}"
                                   FontSize="10"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBox x:Name="MergedNameBox"
                             Text="{Binding MergedMeshName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12"
                             Width="180"
                             VerticalAlignment="Center"
                             ToolTip="Name for the merged output file"
                             Margin="0,0,10,0"/>
                    <Button Content="Export Merged OBJ"
                            Style="{StaticResource PrimaryBtn}"
                            Click="OnExportMergedClick"
                            IsEnabled="{Binding MergeQueueCount, Converter={StaticResource IntToBool}}"
                            Margin="0,0,8,0"
                            ToolTip="Load all queued meshes, merge geometry, and export as one OBJ file"/>
                    <Button Content="Clear"
                            Style="{StaticResource GhostBtn}"
                            Command="{Binding ClearMergeQueueCommand}"
                            ToolTip="Remove all items from the merge queue"/>
                </StackPanel>

                <!-- Asset chips row -->
                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding MergeQueue}"
                              Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AssetInfo}">
                            <Border Background="{StaticResource Panel}"
                                    CornerRadius="7"
                                    Padding="10,4"
                                    Margin="0,0,7,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            FontSize="10"
                                            Margin="8,0,0,0"
                                            Padding="3,0"
                                            Style="{StaticResource GhostBtn}"
                                            Click="OnRemoveFromMergeQueueClick"
                                            Tag="{Binding}"
                                            ToolTip="Remove from merge queue"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ── Status Strip ───────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelDark}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ExportStatus}"
                           FontSize="11"
                           Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ProgressBar Grid.Column="2"
                             Value="{Binding ExportProgress}"
                             Maximum="100"
                             Height="4"
                             VerticalAlignment="Center">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExporting}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>
    </Grid>

</UserControl>
